{
  "expo": {
    "name": "Like No Otter",
    "slug": "like-no-otter",
    "version": "1.0.0",
    "scheme": "likenootter",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.likenootter.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.likenootter.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-health",
        {
          "healthSharePermission": "Allow Like No Otter to read your health data including sleep, steps, calories, and heart rate to display your daily metrics and trends.",
          "healthUpdatePermission": "Allow Like No Otter to save your workout data to Apple Health."
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
